# Database Connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/film_contest

# Authentication (Bắt buộc tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Cloudflare R2 Cloud Storage (Optional for file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fpc-images
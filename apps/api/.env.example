# Database Connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/film_contest

# Authentication (Bắt buộc tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Cloudflare R2 Cloud Storage (Optional for file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fpc-images

# AI Worker · URL dịch vụ model local và cờ bật worker
AI_WEBHOOK_SECRET=
AI_MODEL_URL=http://127.0.0.1:9090/detect
AI_WORKER_ENABLED=false

# Module 01 · Gửi email qua Gmail SMTP
# Đổi địa chỉ mẫu thành Gmail dùng để gửi OTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=filmcontest.demo@gmail.com
# Bật xác minh 2 bước rồi tạo App Password tại https://myaccount.google.com/apppasswords
# Dán App Password bỏ khoảng trắng vào .env, thay cho mật khẩu đăng nhập Gmail.
SMTP_PASSWORD=
SMTP_FROM="CINEGEN <filmcontest.demo@gmail.com>"

# URL HTTPS của màn đặt lại mật khẩu trên Web. Thay tên miền mẫu khi triển khai.
PASSWORD_RESET_URL=https://cinegen.example/auth/reset-password

# Tune warning thresholds with representative contest images.
AI_GENERATED_FLAG_THRESHOLD=0.75
AI_DUPLICATE_MAX_PHASH_DISTANCE=5

# Optional service taking aggregated contest counts and returning { "report": "..." }.
AI_ANALYTICS_URL=
AI_ANALYTICS_API_KEY=
